# ── Base de datos ──
# Local: Postgres de docker/compose.dev.yml (puerto configurable con PYR_DB_PORT)
DATABASE_URL="postgresql://pyr:pyr@localhost:5440/pyr"
# Base usada por tests de integración / E2E
TEST_DATABASE_URL="postgresql://pyr:pyr@localhost:5440/pyr_test"

# ── App ──
APP_URL="http://localhost:3200"
PORT=3200
LOG_LEVEL="debug"

# ── Auth (Better Auth) ──
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
BETTER_AUTH_URL="http://localhost:3200"
# Google OAuth: si quedan vacías, el botón "Ingresar con Google" no se muestra.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin inicial (lo crea el seed) ──
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambiar-esta-clave"

# ── Almacenamiento de imágenes ──
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# Solo si STORAGE_DRIVER=s3 (MinIO, Cloudflare R2, AWS S3...)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
