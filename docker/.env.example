# ─── .env de un entorno en la VPS (copiar a /opt/pyr/<prod|dev>/.env) ───
# Imagen (la setea el deploy de GitHub Actions; editable a mano para rollback)
PYR_IMAGE=ghcr.io/OWNER/pyr
PYR_TAG=main
# Alias en la red "proxy": Caddy lo usa para enrutar (pyr-prod-web / pyr-dev-web)
PYR_PROXY_ALIAS=pyr-prod-web

# Base de datos de ESTE entorno (prod y dev tienen bases separadas)
POSTGRES_USER=pyr
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_DB=pyr

# App
APP_URL=https://trivia.example.com
BETTER_AUTH_URL=https://trivia.example.com
BETTER_AUTH_SECRET=generar-con-openssl-rand-base64-32
LOG_LEVEL=info
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar
# En producción no se cargan datos de prueba
SEED_DEMO=false

STORAGE_DRIVER=local
# STORAGE_DRIVER=s3 + S3_* para MinIO / R2 / S3

# Backups (solo prod, con --profile backup)
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=30 3 * * *
BACKUP_DIR=/opt/pyr/prod/backups
