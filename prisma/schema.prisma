// PyR — modelo de datos.
// Convenciones: ids string (cuid), fechas en UTC, nombres en inglés.
// Las tablas de auth (User, Session, Account, Verification, RateLimit) siguen el esquema de Better Auth.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth / usuarios ─────────────────────────────

enum Role {
  ADMIN
  MOD
  USER
}

model User {
  id                String    @id @default(cuid())
  name              String // nombre visible
  email             String    @unique
  emailVerified     Boolean   @default(false)
  image             String?
  username          String?   @unique
  displayUsername   String?
  role              Role      @default(USER)
  timezone          String    @default("America/Argentina/Buenos_Aires")
  onboardedAt       DateTime?
  usernameChangedAt DateTime? // último cambio de usuario (se limita a uno cada 30 días)
  preferences       Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  bans               Ban[]                  @relation("BannedUser")
  bansIssued         Ban[]                  @relation("BanIssuer")
  auditLogs          AuditLog[]
  questionsAuthored  Question[]             @relation("QuestionAuthor")
  questionsReviewed  Question[]             @relation("QuestionReviewer")
  importJobs         ImportJob[]
  attempts           Attempt[]
  memberships        CategoryMembership[]
  categoryStandings  CategoryStanding[]
  streaks            StreakState[]
  tournamentEntries  TournamentEntry[]
  tournamentStanding TournamentStanding[]
  tournamentResults  TournamentResult[]
  matchesAsA         KnockoutMatch[]        @relation("MatchPlayerA")
  matchesAsB         KnockoutMatch[]        @relation("MatchPlayerB")
  creditTransactions CreditTransaction[]    @relation("CreditOwner")
  creditsIssued      CreditTransaction[]    @relation("CreditIssuer")
  inventory          InventoryTransaction[] @relation("InventoryOwner")
  inventoryIssued    InventoryTransaction[] @relation("InventoryIssuer")
  quizzesCreated     Quiz[]
  tournamentsCreated Tournament[]
  notifications      Notification[]
  backupsRequested   Backup[]
  tickets            Ticket[]               @relation("TicketAuthor")
  ticketsAssigned    Ticket[]               @relation("TicketAssignee")
  ticketEvents       TicketEvent[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Usada por el rate limiter de Better Auth (login/registro).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Rate limiter propio (envío de respuestas, uploads, etc.). Ventana fija por clave.
model RateBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}

model Ban {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  reason      String
  startsAt    DateTime  @default(now())
  endsAt      DateTime? // null = permanente
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("BanIssuer", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([userId, startsAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ej. "question.approve", "ban.create", "credits.adjust"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ───────────────────────────── Configuración ─────────────────────────────

// Parámetros de negocio. Las keys y sus schemas viven en src/server/config/registry.ts.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Textos introductorios editables de la sección "Cómo se juega". Los números salen del config.
model RulesText {
  section   String   @id
  content   String
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Contenido ─────────────────────────────

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String? // nombre de ícono lucide o emoji
  imageKey    String?
  active      Boolean  @default(true)
  settings    Json     @default("{}") // overrides de config por categoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   QuestionCategory[]
  quizzes     Quiz[]
  memberships CategoryMembership[]
  standings   CategoryStanding[]
  streaks     StreakState[]
  tournaments TournamentCategory[]
  schedule    QuizSchedule?
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  questions QuestionTag[]
}

enum QuestionType {
  TEXT
  IMAGE
  IMAGE_TEXT
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Question {
  id             String       @id @default(cuid())
  type           QuestionType @default(TEXT)
  text           String?
  normalizedText String       @default("") // minúsculas sin acentos; índice trigram
  imageKey       String?
  difficulty     Int          @default(2) // 1..5
  explanation    String?
  source         String?
  status         ReviewStatus @default(PENDING_REVIEW)
  reviewComment  String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?        @relation("QuestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  authorId       String?
  author         User?        @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  version        Int          @default(1)
  parentId       String? // versión anterior
  parent         Question?    @relation("QuestionVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children       Question[]   @relation("QuestionVersions")
  shuffleOptions Boolean? // null = hereda del cuestionario
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  options       QuestionOption[]
  categories    QuestionCategory[]
  tags          QuestionTag[]
  quizQuestions QuizQuestion[]

  @@index([status])
  @@index([createdAt])
  @@index([normalizedText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Question_normalizedText_trgm_idx")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  text       String?
  imageKey   String?
  isCorrect  Boolean  @default(false)

  @@unique([questionId, position])
}

model QuestionCategory {
  questionId String
  categoryId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([questionId, categoryId])
  @@index([categoryId])
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  DISCARDED
}

model ImportJob {
  id           String       @id @default(cuid())
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  fileName     String
  status       ImportStatus @default(PREVIEW)
  rows         Json // [{ row, data, errors[], warnings[] }]
  validCount   Int          @default(0)
  invalidCount Int          @default(0)
  createdCount Int          @default(0)
  autoApprove  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  committedAt  DateTime?
}

// ───────────────────────────── Cuestionarios ─────────────────────────────

enum QuizStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  EXPIRED
}

enum TimeMode {
  PER_QUESTION
  TOTAL
}

model Quiz {
  id               String        @id @default(cuid())
  title            String
  description      String?
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  tournamentId     String?
  tournament       Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // status es un caché sincronizado por el worker; la fuente de verdad es getQuizStatus(quiz, now).
  status           QuizStatus    @default(DRAFT)
  publishedAt      DateTime? // null = DRAFT
  opensAt          DateTime
  closesAt         DateTime
  expiresAt        DateTime // fin del período computable
  timeMode         TimeMode      @default(PER_QUESTION)
  timeLimitSec     Int           @default(20) // por pregunta o total según timeMode
  shuffleQuestions Boolean       @default(true)
  shuffleOptions   Boolean       @default(true)
  scoring          Json          @default("{}") // snapshot { base, timeBonus, wrongPenalty } congelado al publicar
  copiedFromId     String?
  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rankedAt         DateTime? // último recálculo de rankings disparado por este quiz
  reviewNotifiedAt DateTime? // se avisó a los jugadores que ya pueden ver la corrección
  openNotifiedAt   DateTime? // se avisó a los miembros de la categoría que abrió
  // Generado por un calendario automático: un borrador por turno (slotAt = apertura prevista).
  scheduleId       String?
  schedule         QuizSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  slotAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  questions QuizQuestion[]
  attempts  Attempt[]
  match     KnockoutMatch?

  @@unique([scheduleId, slotAt])
  @@unique([tournamentId, slotAt])
  @@index([categoryId, opensAt])
  @@index([tournamentId, opensAt])
  @@index([status, closesAt])
}

/// Calendario fijo de una categoría: el worker genera borradores por adelantado para cada turno.
model QuizSchedule {
  id               String     @id @default(cuid())
  categoryId       String     @unique
  category         Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  enabled          Boolean    @default(true)
  // Grilla de turnos: turno N = anchorAt + N × frequencyHours (con frecuencias múltiplo de 24, a la misma hora local).
  anchorAt         DateTime
  frequencyHours   Int        @default(24)
  excludedWeekdays Int[] // 0 = domingo … 6 = sábado, en `timezone`: esos turnos no se publican (la grilla no se corre)
  timezone         String     @default("America/Argentina/Buenos_Aires")
  titleTemplate    String     @default("{categoria} · {fecha}")
  difficultyMix    Json? // { "1": 2, "3": 1 } = cantidad por dificultad; null = sin restricción
  timeMode         TimeMode   @default(PER_QUESTION)
  skippedSlots     DateTime[] // turnos salteados a mano: no se vuelven a generar
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  quizzes Quiz[]
}

model QuizQuestion {
  id             String   @id @default(cuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id])
  position       Int
  shuffleOptions Boolean? // override por pregunta dentro del cuestionario
  voided         Boolean  @default(false) // anulada: no suma ni resta para nadie
  reused         Boolean  @default(false) // elegida por el generador automático entre preguntas ya usadas

  answers AttemptAnswer[]

  @@unique([quizId, questionId])
  @@index([questionId])
}

// ───────────────────────────── Juego ─────────────────────────────

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
  TIMED_OUT
  CANCELLED
}

model Attempt {
  id            String        @id @default(cuid())
  quizId        String
  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        AttemptStatus @default(IN_PROGRESS)
  questionOrder String[] // ids de QuizQuestion en el orden servido
  currentIndex  Int           @default(0)
  startedAt     DateTime      @default(now())
  deadlineAt    DateTime // límite global del intento
  finishedAt    DateTime?
  score         Int           @default(0)
  correctCount  Int           @default(0)
  totalTimeMs   Int           @default(0)
  rewardsGiven  Boolean       @default(false)

  answers     AttemptAnswer[]
  wildcardUse WildcardUse?

  @@unique([quizId, userId])
  @@index([userId, startedAt])
  @@index([status, deadlineAt])
}

model AttemptAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  attempt          Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizQuestionId   String
  quizQuestion     QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  index            Int
  optionOrder      String[] // ids de QuestionOption en el orden mostrado
  servedAt         DateTime     @default(now())
  deadlineAt       DateTime
  answeredAt       DateTime?
  selectedOptionId String?
  isCorrect        Boolean      @default(false)
  timeMs           Int          @default(0)
  basePoints       Int          @default(0)
  bonusPoints      Int          @default(0)
  points           Int          @default(0)

  @@unique([attemptId, quizQuestionId])
  @@unique([attemptId, index])
}

// ───────────────────────────── Liga ─────────────────────────────

enum MembershipStatus {
  ACTIVE
  LEAVING // período de desvinculación: no juega, ocupa vida
  LEFT
}

model CategoryMembership {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status           MembershipStatus @default(ACTIVE)
  joinedAt         DateTime         @default(now())
  leaveRequestedAt DateTime?
  lifeReleasesAt   DateTime? // fin del período de desvinculación
  rejoinAllowedAt  DateTime?

  @@index([userId, status])
  @@index([categoryId, status])
}

model CategoryStanding {
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank           Int
  previousRank   Int?
  points         Int
  quizzesCounted Int
  correctCount   Int
  totalTimeMs    Int
  computedAt     DateTime @default(now())

  @@id([categoryId, userId])
  @@index([categoryId, rank])
}

model StreakState {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  current    Int      @default(0)
  best       Int      @default(0)
  lastQuizId String?
  updatedAt  DateTime @updatedAt

  @@id([userId, categoryId])
}

// ───────────────────────────── Torneos ─────────────────────────────

enum TournamentStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED
}

enum TournamentFormat {
  POINTS // todos juegan los mismos cuestionarios y suman
  KNOCKOUT // eliminatoria: partidos 1 contra 1, el que gana avanza
}

enum SeedingMode {
  QUALIFICATION // por puesto en el torneo de origen; los demás por desempeño en torneos y sorteo
  RANDOM
}

enum QuestionSource {
  NEW_FIRST // nunca usadas primero; si faltan, reutilizadas (si la config lo permite)
  REUSED_FIRST // reutilizadas primero (cuida el banco); si faltan, nuevas
}

enum MatchResult {
  PLAYED
  BYE
  WALKOVER
  TIEBREAK
}

enum WildcardType {
  DOUBLE_TOTAL
  DOUBLE_PER_CORRECT
  TRIPLE_SURPRISE
}

model Tournament {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  name                 String
  description          String?
  imageKey             String?
  status               TournamentStatus @default(DRAFT)
  format               TournamentFormat @default(POINTS)
  // Eliminatoria: frequencyHours = duración de cada ronda; maxParticipants = tamaño máximo del cuadro (potencia de 2).
  seeding              SeedingMode      @default(QUALIFICATION)
  autoConfirmQualified Boolean          @default(true) // los clasificados desde otros torneos quedan inscriptos sin confirmar
  thirdPlaceMatch      Boolean          @default(false)
  questionSource       QuestionSource   @default(NEW_FIRST)
  // Preguntas exclusivas de cada partido; el resto se sortea de un pozo común de la ronda (null = todas distintas).
  uniqueQuestions      Int?
  knockoutPools        Json             @default("{}") // { "<ronda>": [questionId…] } pozo común de cada ronda
  startsAt             DateTime
  endsAt               DateTime
  registrationOpensAt  DateTime
  registrationEndsAt   DateTime
  quizCount            Int              @default(7)
  // Tiempos relativos: las fechas absolutas de arriba se derivan al guardar (tournaments/timeline.ts).
  frequencyHours       Int              @default(24) // un cuestionario cada N horas desde startsAt
  quizActiveHours      Int              @default(24) // cuánto queda abierto cada uno
  registrationLeadDays Int              @default(3) // la inscripción abre N días antes del inicio (0 = al publicar)
  lateEntryDays        Int              @default(0) // la inscripción sigue N días después de empezar
  questionsPerQuiz     Int              @default(10)
  autoQuizzes          Boolean          @default(true) // cuestionarios armados solos con el banco de sus categorías
  // Serie (torneo recurrente): al empezar una edición se crea la siguiente.
  repeatEveryDays      Int?
  seriesId             String? // id de la primera edición
  seriesName           String? // nombre base, sin "#n"
  edition              Int              @default(1)
  nextCreatedAt        DateTime?
  skippedSlots         DateTime[] // turnos cuyo borrador automático se borró a mano (no se regeneran)
  entryCost            Int              @default(0)
  maxParticipants      Int?
  wildcardsPerQuiz     Int              @default(1)
  scoring              Json             @default("{}") // overrides de puntaje
  prizes               Json             @default("[]") // [{ rank, credits }]
  finishedAt           DateTime?
  cancelledAt          DateTime?
  createdById          String?
  createdBy            User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  categories       TournamentCategory[]
  wildcards        TournamentWildcard[]
  entries          TournamentEntry[]
  quizzes          Quiz[]
  standings        TournamentStanding[]
  results          TournamentResult[]
  matches          KnockoutMatch[]
  qualifiers       TournamentQualifier[] @relation("QualifierTarget")
  feeds            TournamentQualifier[] @relation("QualifierSource")
  qualifiedEntries TournamentEntry[]     @relation("EntryQualifiedFrom")

  @@index([seriesId])
}

model TournamentCategory {
  tournamentId String
  categoryId   String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tournamentId, categoryId])
}

model TournamentWildcard {
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  type         WildcardType
  quantity     Int          @default(1) // cuántos puede usar cada participante en todo el torneo

  @@id([tournamentId, type])
}

model TournamentEntry {
  id              String      @id @default(cuid())
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt      DateTime    @default(now())
  ledgerTxId      String?
  // Eliminatoria: clasificado desde otro torneo (sin costo) y confirmación de su lugar.
  qualifiedFromId String?
  qualifiedFrom   Tournament? @relation("EntryQualifiedFrom", fields: [qualifiedFromId], references: [id], onDelete: SetNull)
  qualifiedRank   Int?
  confirmedAt     DateTime? // null = clasificado que todavía no confirmó (no juega)
  seed            Int? // fijado al armar el cuadro (1 = mejor sembrado)

  wildcardUses WildcardUse[]

  @@unique([tournamentId, userId])
}

/// "Los N primeros de X clasifican a esta eliminatoria".
model TournamentQualifier {
  id                 String     @id @default(cuid())
  tournamentId       String
  tournament         Tournament @relation("QualifierTarget", fields: [tournamentId], references: [id], onDelete: Cascade)
  sourceTournamentId String
  source             Tournament @relation("QualifierSource", fields: [sourceTournamentId], references: [id], onDelete: Cascade)
  topN               Int
  appliedAt          DateTime? // ya se inscribió a los clasificados (al terminar el origen)

  @@unique([tournamentId, sourceTournamentId])
  @@index([sourceTournamentId])
}

/// Partido de una eliminatoria. El ganador de (round, position) pasa a (round + 1, position / 2).
/// En la última ronda, position 1 es el partido por el tercer puesto.
model KnockoutMatch {
  id           String       @id @default(cuid())
  tournamentId String
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int // 1 = primera ronda
  position     Int
  playerAId    String?
  playerA      User?        @relation("MatchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerBId    String?
  playerB      User?        @relation("MatchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  seedA        Int?
  seedB        Int?
  quizId       String?      @unique
  quiz         Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  winnerId     String?
  result       MatchResult?
  decidedAt    DateTime?
  opensAt      DateTime
  closesAt     DateTime

  @@unique([tournamentId, round, position])
  @@index([closesAt])
}

model WildcardUse {
  id        String          @id @default(cuid())
  entryId   String
  entry     TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  attemptId String          @unique
  attempt   Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      WildcardType
  state     Json            @default("{}") // estado privado de la estrategia (ej. preguntas sorteadas)
  createdAt DateTime        @default(now())

  @@index([entryId])
}

model TournamentStanding {
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank           Int
  previousRank   Int?
  points         Int
  quizzesCounted Int
  correctCount   Int
  totalTimeMs    Int
  computedAt     DateTime   @default(now())

  @@id([tournamentId, userId])
  @@index([tournamentId, rank])
}

/// Resultado final de un jugador en un torneo terminado. Es una foto (no se recalcula): alimenta
/// las estadísticas del perfil aunque después cambien el torneo, las inscripciones o los baneos.
model TournamentResult {
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank           Int
  participants   Int
  points         Int
  quizzesPlayed  Int
  quizzesTotal   Int
  correctCount   Int
  prizeCredits   Int        @default(0)
  prizeStars     Int        @default(0)
  tournamentName String
  finishedAt     DateTime

  @@id([tournamentId, userId])
  @@index([userId, finishedAt])
}

// ───────────────────────────── Créditos (ledger) ─────────────────────────────

enum CreditTxType {
  SIGNUP_BONUS
  QUIZ_REWARD
  PERFORMANCE_BONUS
  STREAK_BONUS
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  TOURNAMENT_REFUND
  ADMIN_ADJUSTMENT
  PURCHASE
}

enum CreditTxStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreditTransaction {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation("CreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // positivo = alta, negativo = baja
  type           CreditTxType
  status         CreditTxStatus @default(APPROVED)
  reason         String
  idempotencyKey String         @unique
  externalRef    String? // id de pago (Mercado Pago, etc.)
  meta           Json?
  createdById    String?
  createdBy      User?          @relation("CreditIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  settledAt      DateTime?

  @@index([userId, createdAt])
  @@index([externalRef])
}

// ───────────────────────────── Inventario (vidas extra y estrellas) ─────────────────────────────

enum InventoryAsset {
  EXTRA_LIFE
  STAR
}

enum InventoryTxType {
  ADMIN_GRANT
  ADMIN_REVOKE
  TOURNAMENT_PRIZE
  EXCHANGE
  PURCHASE
}

/// Ledger de vidas extra y estrellas: el saldo de cada `asset` es la suma de sus movimientos.
model InventoryTransaction {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation("InventoryOwner", fields: [userId], references: [id], onDelete: Cascade)
  asset          InventoryAsset
  amount         Int // positivo = alta, negativo = baja
  type           InventoryTxType
  reason         String
  idempotencyKey String          @unique
  meta           Json?
  createdById    String?
  createdBy      User?           @relation("InventoryIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([userId, asset])
  @@index([userId, createdAt])
}

// ───────────────────────────── Notificaciones ─────────────────────────────

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

/// STAFF = avisos del panel (admins y mods) · PLAYER = avisos del juego.
enum NotificationAudience {
  STAFF
  PLAYER
}

/// Avisos dentro de la app (hoy solo para admins y mods).
model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  NotificationAudience @default(STAFF)
  level     NotificationLevel
  kind      String // "bank.coverage", "draft.pending", "draft.incomplete", "draft.skipped"
  title     String
  body      String?
  href      String?
  dedupeKey String // evita repetir el mismo aviso
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, audience, readAt])
}

// ───────────────────────────── Backups ─────────────────────────────

enum BackupStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum BackupKind {
  MANUAL
  SCHEDULED
}

/// Backup de la base (+ imágenes con storage local). Lo genera el worker; los archivos viven en BACKUP_DIR.
model Backup {
  id            String       @id @default(cuid())
  kind          BackupKind
  status        BackupStatus @default(PENDING)
  dbFile        String? // nombre del archivo (nunca una ruta)
  uploadsFile   String?
  dbBytes       BigInt?
  uploadsBytes  BigInt?
  error         String?
  requestedById String?
  requestedBy   User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([status, createdAt])
}

// ───────────────────────────── Soporte ─────────────────────────────

enum TicketType {
  BUG
  SUGGESTION
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum TicketEventKind {
  CREATED
  TAKEN
  RELEASED
  ANSWERED
  FEEDBACK
  NOTE
  CLOSED
  REOPENED
}

/// Reporte de bug o sugerencia de un jugador. No es un chat: respuestas del equipo y un feedback por respuesta.
model Ticket {
  id         String        @id @default(cuid())
  number     Int           @unique @default(autoincrement())
  userId     String
  user       User          @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  type       TicketType
  title      String
  body       String
  pageUrl    String?
  userAgent  String?
  imageKey   String?
  status     TicketStatus  @default(OPEN)
  assigneeId String?
  assignee   User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  rounds     Int           @default(0) // respuestas enviadas (tope en tickets/rules.ts)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  closedAt   DateTime?
  events     TicketEvent[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([assigneeId, status])
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind      TicketEventKind
  body      String? // respuesta, comentario del usuario o nota interna (NOTE: nunca se muestra al usuario)
  helpful   Boolean? // solo en FEEDBACK
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
}
